# Copy to .env and fill in locally. Never commit .env.

# Data stores (spec section 15)
# Runtime connection: the non-owner role, so row-level security applies to every query.
DATABASE_URL=postgresql://manorg_app:manorg_app_dev@localhost:5432/manorg
# Migrations and seed: the table owner. Used only by Prisma migrate and the seed script.
DATABASE_MIGRATION_URL=postgresql://manorg_owner:manorg_owner_dev@localhost:5432/manorg
REDIS_URL=redis://localhost:6379

# Tokens
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Product pictures and task photos. STORAGE_DRIVER=local keeps files in ./.storage;
# STORAGE_DRIVER=s3 uses an S3-compatible bucket (set the values below).
STORAGE_DRIVER=local
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_KEY=
STORAGE_SECRET=
STORAGE_REGION=ap-northeast-2

# Push notifications (Phase 1)
FCM_CREDENTIALS=
APNS_KEY=

# AI bot (Phase 2)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

APP_TIMEZONE_DEFAULT=Asia/Seoul

# API
PORT=3001
PUBLIC_API_URL=http://localhost:3001
# Web app
NEXT_PUBLIC_API_URL=http://localhost:3001

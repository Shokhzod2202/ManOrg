# Copy to .env and fill in locally. Never commit .env.

# Data stores (spec section 15)
# Runtime connection: the non-owner role, so row-level security applies to every query.
DATABASE_URL=postgresql://manorg_app:manorg_app_dev@localhost:5432/manorg
# Migrations and seed: the table owner. Used only by Prisma migrate and the seed script.
DATABASE_MIGRATION_URL=postgresql://manorg_owner:manorg_owner_dev@localhost:5432/manorg
REDIS_URL=redis://localhost:6379

# Tokens
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Product pictures and task photos. STORAGE_DRIVER=local keeps files in ./.storage;
# STORAGE_DRIVER=s3 uses an S3-compatible bucket (set the values below).
STORAGE_DRIVER=local
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_KEY=
STORAGE_SECRET=
STORAGE_REGION=ap-northeast-2

# Push notifications (Phase 1)
FCM_CREDENTIALS=
APNS_KEY=

# AI bot (Phase 2)
# AI bot (spec section 10). anthropic (Claude, default model claude-opus-5-5) or xai (Grok, needs
# LLM_MODEL). Empty: the Bot screen says it is not set up. The key is a secret: server env only.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# LLM_EFFORT=high            # Claude effort: low, medium, high, xhigh, max
# BOT_MESSAGES_PER_MINUTE=10 # per organization
# BOT_MONTHLY_TOKEN_BUDGET=2000000

APP_TIMEZONE_DEFAULT=Asia/Seoul

# API
PORT=3001
# Run scheduled jobs (ingredient reminders, Telegram delivery) from Redis with BullMQ. Any number
# of API instances may set this; each job run happens once.
JOBS_ENABLED=true
# Trust the web server in front of the API for the client address (rate limits per person).
TRUST_PROXY=loopback
PUBLIC_API_URL=http://localhost:3001
# Web app: the web server forwards /api/v1 to API_ORIGIN, so the browser uses one origin.
API_ORIGIN=http://localhost:3001
# Set only to make the browser call the API directly instead (needs CORS_ORIGINS on the API).
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Telegram bot @haydar_inc_bot (notifications alongside the app). The token is a secret: set it
# only in the server's environment or secret store, never in git or chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=haydar_inc_bot
# Production: a random secret (openssl rand -hex 24), also passed to setWebhook.
# TELEGRAM_WEBHOOK_SECRET=
# Development or no public URL: read bot updates by long polling instead of a webhook.
TELEGRAM_POLLING=false
# Links in bot messages (buttons appear only for an https address).
WEB_APP_URL=http://localhost:3000

# Phone push through Expo (FCM and APNs). Only needed when the Expo project has enhanced push
# security on; a secret.
# EXPO_ACCESS_TOKEN=

# Email for "Forgot password" links (decided 2026-11-29). An SMTP URL such as
# smtps://user:password@smtp.example.com:465. Empty: emails are written to the API log instead.
SMTP_URL=
MAIL_FROM=Haydar Systems <no-reply@example.com>

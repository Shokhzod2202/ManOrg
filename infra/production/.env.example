# Copy to infra/production/.env on the Windows machine. Never commit .env.
# Prefer infra/production/scripts/generate-env.ps1, which fills the secrets locally.
# Telegram user ids are not secrets. The bot token and webhook secret are secrets.

EDGE_PORT=4317
POSTGRES_PASSWORD=
MANORG_OWNER_PASSWORD=
MANORG_APP_PASSWORD=
REDIS_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Intended bakery admin. Confirm this is still the right person before the first public sign-in.
TELEGRAM_BOOTSTRAP_ADMIN_IDS=5220814834
TELEGRAM_BOOTSTRAP_ORG_NAME=Shohona Bakery
# Shop time zone. The application default remains Asia/Seoul unless this is set.
TELEGRAM_BOOTSTRAP_TIMEZONE=Asia/Tashkent
TELEGRAM_WEBAPP_URL=https://bakery.haydar.store
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=900
APP_TIMEZONE_DEFAULT=Asia/Seoul
CORS_ORIGIN=https://bakery.haydar.store
